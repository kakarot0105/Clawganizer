{
  "version": 1,
  "targets": {
    "Downloads": true,
    "Desktop": true,
    "Documents": false,
    "Pictures": false
  },
  "destination_root": "~",
  "folders": {
    "Images": ["jpg", "jpeg", "png", "gif", "webp", "heic", "heif", "bmp", "tiff", "tif", "svg", "ico", "raw", "cr2", "nef"],
    "Videos": ["mp4", "mov", "avi", "mkv", "wmv", "flv", "webm", "m4v", "mpeg", "mpg", "3gp"],
    "Audio": ["mp3", "wav", "flac", "aac", "ogg", "m4a", "wma", "aiff", "opus"],
    "Documents": ["pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "txt", "rtf", "odt", "ods", "odp", "csv", "md", "pages", "numbers", "key"],
    "Archives": ["zip", "rar", "7z", "tar", "gz", "tgz", "bz2", "xz", "dmg", "iso"],
    "Code": ["py", "js", "ts", "jsx", "tsx", "java", "c", "cpp", "h", "hpp", "go", "rs", "rb", "php", "swift", "kt", "cs", "sh", "bash", "zsh", "json", "yaml", "yml", "toml", "xml", "html", "css", "scss", "sql", "ipynb"],
    "Installers": ["exe", "msi", "pkg", "deb", "rpm", "apk", "appimage", "flatpak"],
    "Fonts": ["ttf", "otf", "woff", "woff2", "eot"],
    "Ebooks": ["epub", "mobi", "azw", "azw3", "fb2"]
  },
  "screenshot_patterns": ["Screenshot*", "Screen Shot*", "CleanShot*", "Capture*"],
  "skip_hidden": true,
  "skip_names": [".DS_Store", "Thumbs.db", "desktop.ini", ".localized"],
  "max_name_collisions": 1000
}
